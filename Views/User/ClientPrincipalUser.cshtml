@model INTELIGENTE_SAZÓN.Dtos.UserDtos
@{
    ViewBag.Title = "SAZÓN INTELIGENTE - Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #EAD9FF;
        font-family: "Cooper Black", sans-serif;
        margin: 0;
        padding: 0;
    }

    .main-container {
        width: 85%;
        max-width: 1200px;
        margin: 40px auto;
        background: #EFE6FA;
        border-radius: 25px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        padding: 30px 50px;
        text-align: center;
    }

    /* Encabezado */
    .header {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        .header .logo {
            position: absolute;
            left: 20px;
            top:10px;

        }

            .header .logo img {
                width: 180px;
                height: auto;
            }

        .header .title {
            font-size: 66px;
            font-weight: 900;
            color: #2B193E;
            font-family: 'Cooper Black', sans-serif;
            margin: 40px;
            margin-left:200px;
        }

    /* Grid central */
    .content-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-gap: 60px 100px;
        justify-items: center;
        margin-top: 40px;
    }

    .single {
        position: relative;
        text-align: center;
    }

    .btn-main {
        background-color: #C6A8F7;
        border: none;
        border-radius: 18px;
        padding: 20px 40px;
        font-size: 22px;
        font-weight: 700;
        color: #2B193E;
        cursor: pointer;
        box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        transition: transform 0.2s ease;
        min-width: 330px;
        white-space: normal;
        word-wrap: break-word;
        text-align:center;
        width:250px;
        display: block;
        margin: 0 auto 15px auto;
        margin-left:45px;
        position:relative;
        z-index:10;
    }

        .btn-main:hover {
            transform: scale(1.05);
        }

    .raton-img {
        width: 115px;
        position: absolute;
        top: -110px;
        left: 50%;
        transform: translateX(-50%);
    }

    .raton-zanahorias {
        width: 180px;
        top: -188px;
        margin-left: -10px;
    }

    .raton-escribiendo {
        width: 180px;
        top: -223px;
        margin-left: -12px;
    }

    .raton-pensando {
        width: 200px;
        top: -210px;
        margin-left: -12px;
    }

    /* Imagen de estante */
    .shelf-img {
        pointer-events: none;
        width: 480px;
        margin-top: -160px;
        margin-left:-25px;
    }

    /* Para el botón del centro */
    .single.full-width {
        grid-column: 1 / span 2;
        margin-top: -20px;
    }

    /* Sección inferior */
    .bottom-links {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 50px;
        padding: 0 15px;
        margin-top: -70px;
    }

    .link-profile {
        font-weight: 700;
        font-size: 22px;
        text-decoration: none;
        color: #2B193E;
        margin-top: 30px;
        position: relative;
        z-index: 10;
    }

    .btn-logout {
        background-color: #B394D4;
        color: #2B193E;
        border: none;
        border-radius: 18px;
        padding: 12px 34px;
        font-size: 22px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        position: relative;
        z-index: 10;
    }

        .btn-logout:hover {
            background-color: #A17CC5;
        }
</style>

<div class="main-container">

    <!-- Encabezado -->
    <div class="header">
        <div class="logo">
            <img src="~/Content/Images/Logo.jpg" alt="logo" />
        </div>
        <h1 class="title">SAZÓN INTELIGENTE</h1>
    </div>

    <!-- GRID -->
    <div class="content-grid">

        <!-- Registro de productos -->
        <div class="single">
            <button class="btn-main" onclick="location.href='@Url.Action("RegisterProduct","Client")'">
                REGISTRO DE PRODUCTOS
            </button>
            <img src="~/Content/Images/shelf.png" class="shelf-img" alt="tabla" />
        </div>

        <!-- Visualizar inventario -->
        <div class="single">
            <button class="btn-main" onclick="location.href='@Url.Action("ViewInventory","Client")'">
                VISUALIZAR INVENTARIO
            </button>
            <img src="~/Content/Images/shelf.png" class="shelf-img" alt="tabla" />
        </div>

        <!-- Eliminar productos (centro) -->
        <div class="single full-width">
            <img src="~/Content/Images/food.png" class="raton-img raton-zanahorias" alt="food" />
            <button class="btn-main" onclick="location.href='@Url.Action("Maintenance","User")'">
                ELIMINAR PRODUCTOS DEL INVENTARIO
            </button>
            <img src="~/Content/Images/shelf.png" class="shelf-img" alt="tabla" />
        </div>

        <!-- Recomendaciones de recetas -->
        <div class="single">
            <img src="~/Content/Images/writemouse.png" class="raton-img raton-escribiendo" alt="write" />
            <button class="btn-main" onclick="location.href='@Url.Action("RecipesRecommendations","Client")'">
                RECOMENDACIONES DE RECETAS
            </button>
            <img src="~/Content/Images/shelf.png" class="shelf-img" alt="tabla" />
        </div>

        <!-- Recetas favoritas -->
        <div class="single">
            <img src="~/Content/Images/mousetongue.png" class="raton-img raton-pensando" alt="tongue" />
            <button class="btn-main" onclick="location.href='@Url.Action("FavoriteRecipes","Client")'">
                RECETAS FAVORITAS
            </button>
            <img src="~/Content/Images/shelf.png" class="shelf-img" alt="tabla" />
        </div>

    </div>

    <!-- Abrir perfil / Cerrar sesión -->
    <div class="bottom-links">
        <a href="@Url.Action("Maintenance","User")" class="link-profile">👤 PERFIL</a>

        <a href="@Url.Action("LoginUser", "User")" class="btn-logout">CERRAR SESIÓN</a>
    </div>
</div>