@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>Sazón Inteligente - Mantenimiento</title>

    <style>
        body {
            background-color: #d9c8f5;
            font-family: "Comic Sans MS", "Arial Rounded MT Bold", sans-serif;
            color: #2b2142;
            padding: 40px;
        }

        .maintenance-container {
            background-color: #e8d9ff;
            border: 2px solid #bfa7f5;
            border-radius: 14px;
            padding: 35px;
            max-width: 650px;
            margin: auto;
            text-align: center;
        }

        h1 {
            color: #3b266f;
            font-size: 30px;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .subtitle {
            font-size: 20px;
            font-weight: bold;
            color: #3b266f;
            margin-bottom: 20px;
        }

        p {
            font-size: 17px;
            line-height: 1.6;
            margin-bottom: 20px;
            text-align: center;
        }

        .icono-mantenimiento {
            font-size: 65px;
            margin-bottom: 15px;
        }

    </style>
</head>

<body>
    <div class="maintenance-container">

        <div class="icono-mantenimiento">
            🔧🛠️
        </div>

        <h1>Estamos en Mantenimiento</h1>

        <div class="subtitle">¡Lo sentimos mucho!</div>

        <p>
            Esta sección de <strong>Sazón Inteligente</strong> se encuentra en mantenimiento en este momento.
        </p>

        <p>
            Nuestro equipo está trabajando para mejorar tu experiencia.
            Por favor, vuelve más tarde.
        </p>

    </div>
</body>
</html>