@model INTELIGENTE_SAZÓN.Dtos.ProfessionalProfileDtos
@{
    ViewBag.Title = "CREACIÓN DE PERFILES PROFESIONALES";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*APARIENCIA DE TODO EL FONDO*@
<style>
    body {
        background-color: #f3eaff;
        font-family: "Cooper Black", sans-serif;
        margin: 0;
        padding: 0;
    }

    .form-wrap {
        background: #d6c8f7;
        padding: 30px;
        border-radius: 12px;
        max-width: 650px;
        width: 100%;
        margin: 100px auto 40px;
    }

    h1 {
        font-size: 45px;
        font-weight: 900;
        color: #1e1432;
        margin-bottom: 25px;
        text-align: center;
    }

    label {
        font-size: 22px;
        color: #1e1432;
        display: block;
        margin: 12px 0 6px;
    }

    .input-full {
        width: 100%;
        padding: 10px 14px;
        border-radius: 12px;
        border: none;
        background: #f6f4fb;
        font-size: 16px;
        margin-bottom: 10px;
    }

    .upload-box {
        width: 100%;
        margin: 12px 0;
        padding: 20px 0;
        background: #e8e4fa;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
    }

        .upload-box .plus {
            width: 40px;
            height: 40px;
            background: #f0f0ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: bold;
            color: #1b1630;
        }

    .roles {
        display: flex;
        justify-content: space-around;
        margin-top: 20px;
    }

    .role-card {
        display: flex;
        align-items: center;
        background: #e8e4fa;
        border-radius: 8px;
        padding: 6px 12px;
        cursor: pointer;
    }

        .role-card img {
            width: 50px;
            height: 50px;
            object-fit: contain;
            margin-right: 10px;
        }

        .role-card span {
            font-size: 16px;
            font-weight: 700;
            color: #1e1432;
        }

        .role-card input {
            display: none;
        }

        .role-card.active {
            border: 2px solid #5b3ee8;
            background: #d9d3fb;
        }

    .save-button {
        display: block;
        margin: 30px auto 0;
        background: #a6a6ff;
        border: none;
        padding: 12px 30px;
        border-radius: 14px;
        font-size: 20px;
        font-weight: 700;
        cursor: pointer;
        color: #1e1432;
    }
</style>


<div class="form-wrap">
    <h1>CREACIÓN DE PERFILES PROFESIONALES</h1>

    <!-- ✅ Mostrar mensajes de éxito o error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @using (Html.BeginForm("CreateProfessionalProfile", "ProfePer", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation" })

        <div class="field row" style="display:flex; gap:20px;">
            <div style="flex:1;">
                @Html.LabelFor(m => m.name_User_Profile, "Nombre: ")
                @Html.TextBoxFor(m => m.name_User_Profile, new { @class = "input-full", placeholder = "Nombre completo" })
                @Html.ValidationMessageFor(m => m.name_User_Profile, "", new { @class = "validation" })
            </div>

            <div style="flex:1;">
                @Html.LabelFor(m => m.email_User_Profile, "Correo electrónico: ")
                @Html.TextBoxFor(m => m.email_User_Profile, new { @class = "input-full", placeholder = "Ejemplo@correo.com" })
                @Html.ValidationMessageFor(m => m.email_User_Profile, "", new { @class = "validation" })
            </div>
        </div>

        <div class="field row" style="display:flex; gap:20px;">
            <div style="flex:1;">
                @Html.LabelFor(m => m.passw_User_Profile, "Contraseña: ")
                @Html.PasswordFor(m => m.passw_User_Profile, new { @class = "input-full", placeholder = "Contraseña" })
                @Html.ValidationMessageFor(m => m.passw_User_Profile, "", new { @class = "validation" })
            </div>

            <div style="flex:1;">
                @Html.LabelFor(m => m.Confirm_Password_Profile, "Confirmar contraseña: ")
                @Html.PasswordFor(m => m.Confirm_Password_Profile, new { @class = "input-full", placeholder = "Confirmar contraseña" })
                @Html.ValidationMessageFor(m => m.Confirm_Password_Profile, "", new { @class = "validation" })
            </div>
        </div>

        <!-- ✅ Subir archivo y mostrar confirmación -->
        <div class="field">
            @Html.Label("Cargue del certificado de estudios: ")
            <div class="upload-box" id="uploadBox" onclick="document.getElementById('Certificate').click();">
                <div class="plus" id="uploadIcon">+</div>
                <div id="fileName" style="margin-top:5px; font-size:14px; color:green;"></div>
                <input id="Certificate" name="Certificate" type="file" style="display:none;" accept=".pdf" onchange="showFileName()" />
            </div>
            @Html.ValidationMessage("Certificate", "", new { @class = "validation" })
        </div>

        <!-- ✅ Seleccionar rol -->
        <div class="field">
            <label>Seleccionar rol:</label>
            @Html.HiddenFor(m => m.ID_Role, new { id = "ID_Role" })
            <div class="roles" style="display:flex; gap:40px; justify-content:center; margin-top:10px;">
                <div id="roleChef" class="role-card" onclick="selectRole(2)">
                    <img src="~/Content/images/ImagenChefPrin.jpg" alt="Chef" style="width:140px; height:140px; border-radius:50%; border:3px solid transparent;" />
                    <div style="font-size:22px; font-weight:700; color:#2b193e;">Chef</div>
                </div>

                <div id="roleIngeniero" class="role-card" onclick="selectRole(3)">
                    <img src="~/Content/images/ImagenIngePrin.jpg" alt="Ingeniero de Alimentos" style="width:140px; height:140px; border-radius:50%; border:3px solid transparent;" />
                    <div style="font-size:22px; font-weight:700; color:#2b193e;">Ingeniero de Alimentos</div>
                </div>
            </div>
            @Html.ValidationMessageFor(m => m.ID_Role, "", new { @class = "validation" })
        </div>

        <button type="submit" class="save-button">GUARDAR</button>
    }
</div>

<!-- ✅ Script JS -->
<script>
    // Muestra el nombre del archivo cargado
    function showFileName() {
        const fileInput = document.getElementById('Certificate');
        const fileName = document.getElementById('fileName');
        const uploadIcon = document.getElementById('uploadIcon');

        if (fileInput.files.length > 0) {
            fileName.textContent = "Archivo cargado: " + fileInput.files[0].name;
            uploadIcon.textContent = "✔"; // Cambia el + por un check
            uploadIcon.style.color = "green";
        } else {
            fileName.textContent = "";
            uploadIcon.textContent = "+";
            uploadIcon.style.color = "black";
        }
    }

    // Cambia visualmente el botón seleccionado y guarda el rol
    function selectRole(roleId) {
        document.getElementById('ID_Role').value = roleId;

        const chef = document.getElementById('roleChef');
        const ing = document.getElementById('roleIngeniero');

        // Quitar borde a ambos
        chef.querySelector('img').style.border = "3px solid transparent";
        ing.querySelector('img').style.border = "3px solid transparent";

        // Aplicar borde verde al seleccionado
        if (roleId === 2) {
            chef.querySelector('img').style.border = "3px solid green";
        } else {
            ing.querySelector('img').style.border = "3px solid green";
        }
    }
</script>