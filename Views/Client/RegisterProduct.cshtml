@model INTELIGENTE_SAZÓN.Dtos.RegisterProductViewModel
@{
    ViewBag.Title = "Registro de Productos";
}

<style>
    .main-container {
        background-color: #EAD9FF;
        padding: 30px;
        border-radius: 20px;
        width: 90%;
        margin: auto;
        font-family: 'Cooper Black', sans-serif;
    }

    .title {
        font-family: 'Cooper Black', sans-serif;
        font-size: 50px;
        text-align: center;
        margin-bottom: 25px;
    }

    .search-box {
        background: #d9b6ff;
        padding: 10px;
        border-radius: 20px;
        width: 35%;
        margin: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .search-box input {
            width: 90%;
            border-radius: 10px;
            padding: 10px;
            border: none;
            font-size: 16px;
            margin-left: 28px;
            font-family: 'Cooper Black', sans-serif;
        }

        .search-box button {
            background: transparent;
            border: none;
            font-size: 30px;
            cursor: pointer;
        }

    .food-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px;
        background: #d8b8ff;
        margin-top: 12px;
        border-radius: 15px;
        flex-wrap: wrap;
        font-family: 'Cooper Black', sans-serif;
    }

    .food-img {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        object-fit: cover;
        margin-right: 15px;
    }

    .food-name {
        font-size: 35px;
        flex: 1;
        min-width: 120px;
        font-family: 'Cooper Black', sans-serif;
    }

    .amountInput,
    .unitSelect,
    .categorySelect {
        font-size: 16px;
        padding: 6px;
        border-radius: 10px;
        border: none;
        margin-left: 10px;
        width: 110px;
        font-family: 'Cooper Black', sans-serif;
    }

    .button-container {
        display: flex;
        justify-content: center;
        gap: 30px;
        margin-top: 30px;
        font-family: 'Cooper Black', sans-serif;
    }

    .btn-action {
        background: #b388ff;
        padding: 10px 30px;
        border-radius: 15px;
        color: white;
        border: none;
        font-size: 20px;
        cursor: pointer;
        transition: background 0.3s;
        font-family: 'Cooper Black', sans-serif;
    }

        .btn-action:hover {
            background: #a06fff;
        }

    /* Mensaje verde */
    #successMessage {
        text-align: center;
        font-size: 20px;
        font-weight: bold;
        color: green;
        margin-bottom: 15px;
        background-color: #E6DAFF;
        border-radius: 10px;
        padding: 10px;
        display: none;
        font-family: 'Cooper Black', sans-serif;
    }
</style>

<div class="main-container">

    <div id="successMessage">✅ Registro de alimentos exitoso.</div>

    <h1 class="title">REGISTRO DE PRODUCTOS</h1>

    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Buscar alimentos...">
        <button onclick="filterFoods()">🔍</button>
    </div>

    <div id="foodsContainer">
        @foreach (var food in Model.Foods)
        {
            <div class="food-item" data-name="@food.name_Food.ToLower()">
                <img class="food-img" src="@food.imag_Food" alt="Imagen">
                <div class="food-name">@food.name_Food</div>

                <input type="number" class="amountInput" placeholder="Cantidad" />
                <select class="unitSelect">
                    <option value="">--Unidad--</option>
                    @foreach (var u in Model.Units)
                    {
                        <option value="@u.Key">@u.Value</option>
                    }
                </select>

                <select class="categorySelect">
                    <option value="">--Categoría--</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Key">@c.Value</option>
                    }
                </select>

                <input type="hidden" class="foodId" value="@food.ID_Food" />
            </div>
        }
    </div>

    <div class="button-container">
        <button class="btn-action" onclick="sendData()">AGREGAR</button>
        <a href="@Url.Action("ClientPrincipalUser", "User")" class="btn-action" style="text-decoration:none; text-align:center;">CANCELAR</a>
    </div>
</div>

<script>
    function filterFoods() {
        let text = document.getElementById("searchInput").value.toLowerCase();
        let items = document.querySelectorAll(".food-item");
        items.forEach(i => {
            let name = i.getAttribute("data-name");
            i.style.display = name.includes(text) ? "flex" : "none";
        });
    }

    function sendData() {
        let items = [];
        document.querySelectorAll(".food-item").forEach(row => {
            let amount = row.querySelector(".amountInput").value;
            let unit = row.querySelector(".unitSelect").value;
            let categ = row.querySelector(".categorySelect").value;
            let idFood = row.querySelector(".foodId").value;

            if (amount && unit && categ) {
                items.push({
                    ID_Food: parseInt(idFood),
                    amount_Product: parseInt(amount),
                    ID_Unit_Measure: parseInt(unit),
                    ID_Categ_Food: parseInt(categ)
                });
            }
        });

        if (items.length === 0) {
            alert("Debe completar al menos un producto.");
            return;
        }

        $.ajax({
            url: '@Url.Action("SaveProducts", "Client")',
            method: "POST",
            data: JSON.stringify({ items: items }),
            contentType: "application/json; charset=utf-8",
            success: function () {
                let msg = document.getElementById("successMessage");
                msg.style.display = "block";
                
            }
        });
    }
</script>