@{
    ViewBag.Title = "OPCIONES DEL ADMINISTRADOR";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*APARIENCIA DE TODO*@
<style>
    body {
        background-color: #e6d6fa;
        font-family: "Cooper Black", sans-serif;
    }

    .admin-container {
        background-color: #d9c9ff;
        width: 500px;
        margin: 50px auto;
        padding: 30px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }

    .admin-header {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        margin-bottom: 20px;
    }

        .admin-header img {
            width: 85px;
            margin-right: 20px;
        }

        .admin-header h1 {
            font-size: 35px;
            font-weight: bold;
            color: #3a2a6a;
            margin: 0;
        }

    .admin-subtitle {
        font-size: 16px;
        margin-bottom: 20px;
        color: #4a4a4a;
    }

    .admin-buttons button {
        display: block;
        width: 100%;
        margin: 10px 0;
        padding: 15px;
        background-color: #a6a6ff;
        border: none;
        border-radius: 12px;
        font-weight: bold;
        font-size: 16px;
        color: #222;
        cursor: pointer;
    }

        .admin-buttons button:hover {
            background-color: #8d8df5;
        }
</style>

<div class="admin-container">
    <div class="admin-header">
        <img src="~/Content/images/ImagenAdmi.jpg" alt="Logo del Administrador" />
        <h1>¡HOLAA ADMINISTRADOR!</h1>
    </div>
    <p class="admin-subtitle">Selecciona la opción a la cuál deseas acceder:</p>

    <div class="admin-buttons">
        <button onclick="location.href='@Url.Action("CreateProfiles", "User")'">
            CREACIÓN DE PERFILES PROFESIONALES
        </button>
        <button onclick="location.href='@Url.Action("ActivateProfiles", "User")'">
            ACTIVAR O DESACTIVAR PERFILES PROFESIONALES
        </button>
        <button onclick="location.href='@Url.Action("DeleteProfiles", "User")'">
            ELIMINAR PERFILES PROFESIONALES
        </button>
        <button onclick="location.href='@Url.Action("MonthlyReports", "User")'">
            VISUALIZAR LOS REPORTES MENSUALES
        </button>
    </div>
</div>