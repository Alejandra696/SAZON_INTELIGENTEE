@model INTELIGENTE_SAZÓN.Dtos.UserDtos
@{
    ViewBag.Title = "REGISTRO DE USUARIOS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/Register.css" rel="stylesheet" />


@*APARIENCIA DE TODO EL FONDO*@
<style>
    body {
        background-color: #f3eaff;
        font-family: Cooper, sans-serif;
    }

    .register-container {
        background: #d6c8f7;
        padding: 30px;
        max-width: 700px;
        margin: 40px auto;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        display: flex;
        align-items: flex-start;
        gap: 20px;
    }

    .logo {
        width: 120px;
        height: auto;
    }

    .form-section {
        flex: 1;
    }

        .form-section h1 {
            font-size: 40px;
            font-weight: bold;
            color: #2c1555;
            margin-bottom: 25px;
            font-family: 'Cooper', cursive, sans-serif;
        }

    .form-row {
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .form-row label {
            width: 180px;
            font-size: 18px;
            font-weight: 600;
            color: #2c1555;
        }

    .form-input {
        flex: 1;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 16px;
    }

    .btns {
        display: flex;
        justify-content: space-around;
        margin-top: 20px;
    }

    .btn-guardar, .btn-cancelar {
        padding: 12px 40px;
        border: none;
        border-radius: 20px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        background: #b4b4f7;
        color: #1a1a1a;
        transition: background 0.3s;
    }

        .btn-guardar:hover {
            background: #8a8ae6;
        }

        .btn-cancelar:hover {
            background: #f28b82;
            color: white;
        }
</style>


@*LLAMADO CLASES*@
<div class="register-container">
    <img src="~/Content/Images/Logo.jpg" alt="Logo de la Página Web" class="logo" />

    <div class="form-section">
        <h1>SAZÓN INTELIGENTE</h1>

        @using (Html.BeginForm("Register", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-row">
                <label>Nombre: </label>
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-input", placeholder = "Nombre completo" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
            </div>

            <div class="form-row">
                <label>Correo electrónico: </label>
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-input", placeholder = "Correo@ejemplo.com", type = "email" })
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
            </div>

            <div class="form-row">
                <label>Teléfono: </label>
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-input", placeholder = "(300) 555-0000" })
                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
            </div>

            <div class="form-row">
                <label>Contraseña: </label>
                @Html.PasswordFor(m => m.Password, new { @class = "form-input", placeholder = "Contraseña" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-row">
                <label>Confirmar contraseña: </label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-input", placeholder = "Confirmar contraseña" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <div class="btns">
                <button type="submit" class="btn-guardar">GUARDAR</button>
                <a href="@Url.Action("Index", "Home")" class="btn-cancelar">CANCELAR</a>
            </div>
        }
    </div>
</div>