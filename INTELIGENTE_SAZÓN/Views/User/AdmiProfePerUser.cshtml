@model INTELIGENTE_SAZÓN.Dtos.ProfePerDtos
@{
    ViewBag.Title = "CREACIÓN DE PERFILES PROFESIONALES";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*APARIENCIA DE TODO EL FONDO*@
<style>
    body {
        background-color: #f3eaff;
        font-family: "Cooper Black", sans-serif;
        margin: 0;
        padding: 0;
    }

    .form-wrap {
        background: #d6c8f7;
        padding: 30px;
        border-radius: 12px;
        max-width: 650px;
        width: 100%;
        margin: 100px auto 40px; 
    }

    h1 {
        font-size: 45px;
        font-weight: 900;
        color: #1e1432;
        margin-bottom: 25px;
        text-align: center;
    }

    label {
        font-size: 22px;
        color: #1e1432;
        display: block;
        margin: 12px 0 6px;
    }

    .input-full {
        width: 100%;
        padding: 10px 14px;
        border-radius: 12px;
        border: none;
        background: #f6f4fb;
        font-size: 16px;
        margin-bottom: 10px;
    }

    .upload-box {
        width: 100%;
        margin: 12px 0;
        padding: 20px 0;
        background: #e8e4fa;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
    }

        .upload-box .plus {
            width: 40px;
            height: 40px;
            background: #f0f0ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: bold;
            color: #1b1630;
        }

    .roles {
        display: flex;
        justify-content: space-around;
        margin-top: 20px;
    }

    .role-card {
        display: flex;
        align-items: center;
        background: #e8e4fa;
        border-radius: 8px;
        padding: 6px 12px;
        cursor: pointer;
    }

        .role-card img {
            width: 50px;
            height: 50px;
            object-fit: contain;
            margin-right: 10px;
        }

        .role-card span {
            font-size: 16px;
            font-weight: 700;
            color: #1e1432;
        }

        .role-card input {
            display: none;
        }

        .role-card.active {
            border: 2px solid #5b3ee8;
            background: #d9d3fb;
        }

    .save-button {
        display: block;
        margin: 30px auto 0;
        background: #a6a6ff;
        border: none;
        padding: 12px 30px;
        border-radius: 14px;
        font-size: 20px;
        font-weight: 700;
        cursor: pointer;
        color: #1e1432;
    }
</style>

<div class="form-wrap">
    <h1>CREACIÓN DE PERFILES PROFESIONALES</h1>

    @using (Html.BeginForm("CreateProfiles", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation" })

        <div class="field row" style="display:flex; gap:20px;">
            <div style="flex:1;">
                @Html.LabelFor(m => m.Nombre, "Nombre: ")
                @Html.TextBoxFor(m => m.Nombre, new { @class = "input-full", placeholder = "Nombre completo" })
                @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "validation" })
            </div>

            <div style="flex:1;">
                @Html.LabelFor(m => m.Email, "Correo electrónico: ")
                @Html.TextBoxFor(m => m.Email, new { @class = "input-full", placeholder = "Ejemplo@correo.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "validation" })
            </div>
        </div>

        <div class="field row" style="display:flex; gap:20px;">
            <div style="flex:1;">
                @Html.LabelFor(m => m.Password, "Contraseña: ")
                @Html.PasswordFor(m => m.Password, new { @class = "input-full", placeholder = "Contraseña" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "validation" })
            </div>

            <div style="flex:1;">
                @Html.LabelFor(m => m.ConfirmPassword, "Confirmar contraseña: ")
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "input-full", placeholder = "Confirmar contraseña" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "validation" })
            </div>
        </div>

        <div class="field">
            @Html.Label("Cargue del certificado de estudios: ")
            <div class="upload-box" id="uploadBox" onclick="document.getElementById('Certificate').click();">
                <div class="plus">+</div>
                <input id="Certificate" name="Certificate" type="file" style="display:none;" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
            </div>
            @Html.ValidationMessage("Certificate", "", new { @class = "validation" })
        </div>

        <div class="field">
            <label>Seleccionar rol:</label>
            @Html.HiddenFor(m => m.Role, new { id = "Role" })
            <div class="roles">
                <div id="role-Chef" class="role-card" onclick="selectRole('Chef')">
                    <img src="~/Content/images/ImagenChefPrin.jpg" alt="Imagen del Chef" />
                    <div style="font-size:22px; font-weight:700; color:#2b193e;">Chef</div>
                </div>

                <div id="role-IngenieroAlimentos" class="role-card" onclick="selectRole('IngenieroAlimentos')">
                    <img src="~/Content/images/ImagenIngePrin.jpg" alt="Imagen del Ingeniero de Alimentos" />
                    <div style="font-size:22px; font-weight:700; color:#2b193e;">Ingeniero de Alimentos</div>
                </div>
            </div>
            @Html.ValidationMessageFor(m => m.Role, "", new { @class = "validation" })
        </div>

        <button type="submit" class="save-button">GUARDAR</button>
    }
</div>